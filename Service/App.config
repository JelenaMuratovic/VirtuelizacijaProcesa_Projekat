<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<add key="A_threshold" value="0.9"/>
		<add key="W_threshold" value="2.5"/>
		<add key="odstupanje" value="0.25"/>
	</appSettings>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="DroneTcpBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="10485760"
						 openTimeout="00:00:10"
						 sendTimeout="00:00:30"
						 receiveTimeout="00:05:00">
				</binding>
			</netTcpBinding>
		</bindings>
		<services>
			<service name="Service.DroneService">
				<host>
					<baseAddresses>
						<add baseAddress="net.tcp://localhost:4002" />
					</baseAddresses>
				</host>
				<endpoint
					address="DroneService"
					binding="netTcpBinding"
					contract="Common.IDroneService" />
			</service>
		</services>
	</system.serviceModel>
</configuration>